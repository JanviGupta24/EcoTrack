# EcoTrack Frontend Environment Variables (.env.example)
#
# IMPORTANT
# - This file is safe to commit.
# - Do NOT put real secrets here.
# - Copy this file to `frontend/.env` and replace placeholders.

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Backend base URL for React Axios instance.
REACT_APP_API_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# Used by `@react-oauth/google` for Google sign-in.
REACT_APP_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
REACT_APP_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# -----------------------------------------------------------------------------
# Razorpay (Wallet Top-up)
# -----------------------------------------------------------------------------
REACT_APP_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
REACT_APP_RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# -----------------------------------------------------------------------------
# Google Maps (Optional)
# -----------------------------------------------------------------------------
# Used for map-related UI features.
REACT_APP_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Lint settings (optional)
# -----------------------------------------------------------------------------
ESLINT_NO_DEV_ERRORS=true
DISABLE_ESLINT_PLUGIN=true

