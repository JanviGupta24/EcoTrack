{
  "name": "ecotrack-frontend",
  "version": "1.0.0",
  "description": "Smart Waste Management System - React Frontend",
  "private": true,
  "dependencies": {
    "@react-oauth/google": "^0.12.2",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.16",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.1",
    "react-scripts": "^5.0.1",
    "react-toastify": "^9.1.3",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "eslint-plugin-prettier": "^5.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.3.6"
  },
  "scripts": {
    "start": "npx react-scripts start",
    "comment:start": "Runs the app in development mode.",
    "build": "npx react-scripts build",
    "comment:build": "Builds the app for production.",
    "test": "npx react-scripts test",
    "comment:test": "Runs the app's test suite.",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "comment:format": "Formats all code using Prettier.",
    "eject": "npx react-scripts eject",
    "fix-eslint": "node setup-eslint.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "no-unused-vars": "warn",
      "react-hooks/exhaustive-deps": "warn",
      "jsx-a11y/anchor-is-valid": "warn",
      "prettier/prettier": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000"
}
