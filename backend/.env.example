# EcoTrack Backend Environment Variables (.env.example)
#
# IMPORTANT
# - This file is safe to commit.
# - Do NOT put real secrets here. Use environment variables or your local `.env`.
# - Copy this file to `backend/.env` and replace placeholders.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# The URL your frontend runs on (used for CORS allowlist)
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (MongoDB)
# -----------------------------------------------------------------------------
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/ecotrack

# MongoDB Atlas example (uncomment and replace placeholders):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ecotrack

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Must be at least 32 characters (recommended).
JWT_SECRET=YOUR_JWT_SECRET_HERE_CHANGE_ME

# Refresh token secret (recommended to be a different value than JWT_SECRET)
JWT_REFRESH_SECRET=YOUR_REFRESH_JWT_SECRET_HERE_CHANGE_ME

# -----------------------------------------------------------------------------
# Google OAuth 2.0
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# -----------------------------------------------------------------------------
# Cloudinary (Image Uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# -----------------------------------------------------------------------------
# Twilio (SMS OTP)
# -----------------------------------------------------------------------------
# If these are missing, SMS OTP sending is disabled by the app.
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN

# -----------------------------------------------------------------------------
# Gemini (AI)
# -----------------------------------------------------------------------------
# Used for chatbot, waste classification (vision), insights, and quizzes.
# If missing, AI endpoints return 503 instead of crashing.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# -----------------------------------------------------------------------------
# Razorpay (Wallet Top-up)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# -----------------------------------------------------------------------------
# Email (OTP + notifications)
# -----------------------------------------------------------------------------
EMAIL_USER=YOUR_SMTP_EMAIL_USERNAME
EMAIL_PASS=YOUR_SMTP_EMAIL_PASSWORD
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

